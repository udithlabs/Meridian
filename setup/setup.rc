#include "resource.h"
IDI_APP ICON "../assets/app.ico"
1 24 "setup.manifest"
IDR_FONT_SORA200 RCDATA "../assets/fonts/Sora-ExtraLight.ttf"
IDR_FONT_SORA300 RCDATA "../assets/fonts/Sora-Light.ttf"
IDR_FONT_SORA500 RCDATA "../assets/fonts/Sora-Medium.ttf"
IDR_FONT_SERIF   RCDATA "../assets/fonts/InstrumentSerif-Regular.ttf"
IDR_FONT_SERIF_I RCDATA "../assets/fonts/InstrumentSerif-Italic.ttf"
IDR_FONT_MONO    RCDATA "../assets/fonts/DMMono-Regular.ttf"
IDR_FONT_MONO_M  RCDATA "../assets/fonts/DMMono-Medium.ttf"
IDR_PAYLOAD      RCDATA "payload.bin"
IDR_NOTES        RCDATA "notes.txt"
IDR_SONG         RCDATA "song.dat"

1 VERSIONINFO
FILEVERSION 3,0,0,0
PRODUCTVERSION 3,0,0,0
FILEOS 0x4
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Meridian"
      VALUE "FileDescription", "Meridian 3.0.0 ""Aurora"" Setup (Sonnet Edition)"
      VALUE "FileVersion", "3.0.0.0"
      VALUE "InternalName", "Meridian-Setup"
      VALUE "LegalCopyright", "Fonts: Sora, Instrument Serif, DM Mono (SIL OFL 1.1)."
      VALUE "OriginalFilename", "Meridian-Setup.exe"
      VALUE "ProductName", "Meridian - Sonnet Edition"
      VALUE "ProductVersion", "3.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
