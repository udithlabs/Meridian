        {"type": "glow", "x": "(0.5 + 0.1550*cw) + 0.075*cos(t*0.9)", "y": "(cityB - 0.2969*ch) + 0.004", "rx": 0.085, "ry": 0.0042, "color": "#FFE9A8", "opacity": "light*0.55*max(0, sin(t*0.9))"},
        // ==== THE WATER: boats cruising along the sea, each with a wake and a faint reflection. 'count' boats, each trip picks its own lane (y0..y1), direction and speed ====
        {"type": "traffic", "vehicle": "boat", "count": 7, "seed": 2, "y0": "horizon + 0.04", "y1": 0.955, "period": 95, "size": "portrait ? 0.075 : 0.105", "color": "#150629", "color2": "#FFD9B0", "color3": "#FF3E91", "opacity": "light"},
        // ==== THE POLICE HELICOPTER: just one, always on patrol low over the city roofs, its searchlight sweeping the streets (never the sea). 'fly' is the height its light lands on ====
        {"type": "traffic", "vehicle": "heli", "count": 1, "seed": 5, "y0": "horizon - 0.125", "y1": "horizon - 0.075", "period": 80, "size": "portrait ? 0.045 : 0.056", "fly": "horizon - 0.022", "color": "#12052A", "color2": "#FFF3D6", "color3": "#FF2B3D"},
        // ==== A PLANE DRAGS A BANNER now and then, with a message that depends on how close the date is. It is drawn BEFORE the palm trees and the text, so it flies BEHIND the big number and the clock digits.
        // Every other trip it takes the other lane: one time behind the big number, the next time behind hours:minutes:seconds.
        // "plane" is the picture art/plane.png (nose pointing right, tail at its left edge); "y" is the height of the lane (the middle of the banner), "planeH" its size,
        // "period" / "fly" how often it comes and how many seconds a trip takes. ====
        {"type": "banner", "y": "mod(floor(t/44), 2) < 1 ? numY - numCap*0.52 : hmsY - hmsCap*0.5", "h": "portrait ? 0.04 : 0.05", "size": "portrait ? 0.021 : 0.026", "plane": "art/plane.png", "planeH": "portrait ? 0.062 : 0.085", "period": 44, "fly": 24, "fill": "#1A0A40EB", "edge": "#FF5CA8", "ink": "#FFF3E6", "opacity": "cdA", "text": [{"when": "doneN > 0 && release_done == 0", "text": ["{doneN} OF 14 REGIONS ARE ALREADY PLAYING", "SOMEWHERE IT'S ALREADY THURSDAY", "NEW ZEALAND GOES FIRST. NO SPOILERS.", "THE ROLLOUT HAS STARTED"]}, {"when": "releaseDay", "text": ["IT'S HERE. GO. NOW.", "WELCOME BACK TO VICE CITY", "OCEAN VIEW CHECK-IN IS OPEN", "ALL YOU HAD TO DO WAS WAIT FOR LAUNCH", "SNACKS. CONTROLLER. GO.", "MISSION PASSED. RESPECT +", "FLASH FM IS TAKING REQUESTS"]}, {"when": "release_done", "text": ["ENJOY THE TRIP", "ANOTHER DAY IN VICE CITY", "GREETINGS FROM OCEAN DRIVE", "FROM LIBERTY CITY TO LEONIDA", "TAKE A BREAK. DRINK WATER.", "STILL SIX STARS? SAME."]}, {"when": "release_daysf > 60", "text": ["PLENTY OF TIME TO CLEAR THE BACKLOG", "TUNED TO V-ROCK ON OCEAN BEACH", "THE HYPE IS REAL. SO IS THE WAIT.", "FREE UP SOME STORAGE", "GOOD THINGS TAKE A WHILE"]}, {"when": "release_daysf > 30", "text": ["LESS THAN TWO MONTHS", "GROVE STREET TO VICE BEACH SOON", "KEEP THE CONTROLLER CHARGED", "PORTLAND TO CHILIAD TO LEONIDA", "THE COUNTDOWN IS ON"]}, {"when": "release_daysf > 7", "text": ["CLEAR YOUR CALENDAR", "WEEKS, NOT MONTHS", "STATUE OF HAPPINESS APPROVES", "ALL YOU HAD TO DO WAS FOLLOW THE HYPE", "DON'T BELIEVE THE SPOILERS", "STOCK UP ON SNACKS"]}, {"when": "release_daysf > 1", "text": ["THIS WEEK. FOR REAL.", "CORTEZ YACHT LEAVES THIS WEEK", "CHARGE EVERYTHING", "LAST FLIGHT FROM LOS SANTOS", "SLEEP NOW, PLAY LATER", "NOT LONG NOW"]}, {"text": ["TOMORROW. SERIOUSLY.", "PACK YOUR BAGS FOR OCEAN BEACH", "ONE MORE SLEEP", "LAST NIGHT BEFORE VICE CITY", "TRY TO SLEEP TONIGHT"]}]},
        // ==== palm trees in front, swaying ====
        {"type": "image", "src": "art/palm_a.png", "x": 0.055, "y": 1.015, "anchor": "bottom-center", "h": "0.59*pf", "rotate": "1.3*sin(t*0.42) + 0.5*sin(t*1.1)", "opacity": "light"},
        {"type": "image", "src": "art/palm_b.png", "x": 0.145, "y": 1.015, "anchor": "bottom-center", "h": "0.40*pf", "rotate": "1.3*sin(t*0.49 + 1.9) + 0.5*sin(t*1.2 + 0.7)", "opacity": "light"},
        {"type": "image", "src": "art/palm_c.png", "x": 0.945, "y": 1.015, "anchor": "bottom-center", "h": "0.555*pf", "rotate": "1.3*sin(t*0.56 + 3.8) + 0.5*sin(t*1.3 + 1.4)", "opacity": "light"},
        {"type": "image", "src": "art/palm_d.png", "x": 0.855, "y": 1.015, "anchor": "bottom-center", "h": "0.366*pf", "rotate": "1.3*sin(t*0.63 + 5.7) + 0.5*sin(t*1.4 + 2.1)", "opacity": "light"},
        // ==== release day: police lights at the edges, and confetti ====
        {"type": "glow", "x": 0, "y": 0.5, "rx": 0.3, "ry": 0.7, "color": "#FF2B3D", "opacity": "0.34*(sin(t*7) > 0)*releaseDay"},
        {"type": "glow", "x": 1, "y": 0.5, "rx": 0.3, "ry": 0.7, "color": "#2B7BFF", "opacity": "0.34*(sin(t*7) <= 0)*releaseDay"},
        {"type": "confetti", "when": "releaseDay", "count": 60, "colors": ["#FF3E91", "#2FE6D3", "#FFD36B", "#7B3FE4"]},
        // weather: this pack always looks the same (gloom and haze stay 0 unless the file says "weather": true), so this layer draws nothing unless you switch that on
        {"type": "shade", "alpha": "0.46*gloom + 0.22*haze", "alpha2": "0.30*haze"},
        {"type": "gradient", "y0": 0.9, "y1": 1, "colors": ["#0D031F00", "#0D031F9E"]},
        // ==== the launch map view darkens everything behind it (it fades in and out with the pill) ====
        {"type": "rect", "when": "mapOn", "x": 0, "y": 0, "w": 1, "h": 1, "color": "#0E0426", "opacity": "vm*0.86"},
        // ==== THE TOP ROW (both views): the title, the time, and the pill that switches views ====
        {"type": "text", "text": "GRAND THEFT AUTO VI", "x": 0.05, "y": 0.075, "size": "min(0.026, 0.028*W/H)", "align": "left", "color": "#2FE6D3", "tracking": 0.32, "maxw": "portrait ? 0.5 : pillX - 0.06", "opacity": 0.95, "font": "monoMedium"},
        {"type": "text", "text": "NOW  {time}", "x": 0.95, "y": 0.075, "size": "min(0.026, 0.028*W/H)", "align": "right", "color": "#FFF3E6", "tracking": 0.2, "opacity": 0.8, "font": "monoMedium"},
        // the view pill: two halves (the lit half is the view you are in). Click a half, or press Tab / Space to switch. 'button' is an invisible click area:
        // "set" is the number it changes (see "state" above), "to" what it is changed to, "key" a key that does the same.
        {"type": "rect", "x": "pillX", "y": "pillY", "w": "pillW", "h": "pillH", "radius": "pillH/2", "color": "#12052C/0.62"},
        {"type": "rect", "x": "pillX + 0.0025", "y": "pillY + 0.004", "w": "seg0 - 0.0025", "h": "pillH - 0.008", "radius": "(pillH - 0.008)/2", "color": "#FF3E91", "opacity": "cdA"},
        {"type": "rect", "x": "pillX + seg0", "y": "pillY + 0.004", "w": "pillW - seg0 - 0.0025", "h": "pillH - 0.008", "radius": "(pillH - 0.008)/2", "color": "#FF3E91", "opacity": "vm"},
        {"type": "rect", "x": "pillX", "y": "pillY", "w": "pillW", "h": "pillH", "radius": "pillH/2", "thick": 0.0012, "color": "#FF3E91/0.85"},
        {"type": "text", "text": "COUNTDOWN", "x": "pillX + seg0/2", "y": "pillY + pillH/2 + fs*0.36", "size": "fs", "color": "#12052A", "tracking": 0.16, "maxw": "seg0*0.9", "opacity": "cdA", "font": "monoMedium"},
        {"type": "text", "text": "LAUNCH MAP  ·  {utc}", "x": "pillX + seg0 + (pillW - seg0)/2", "y": "pillY + pillH/2 + fs*0.36", "size": "fs", "color": "#12052A", "tracking": 0.16, "maxw": "(pillW - seg0)*0.92", "opacity": "vm", "font": "monoMedium"},
        {"type": "text", "text": "COUNTDOWN", "x": "pillX + seg0/2", "y": "pillY + pillH/2 + fs*0.36", "size": "fs", "color": "#FFF3E6", "tracking": 0.16, "maxw": "seg0*0.9", "opacity": "vm", "font": "monoMedium"},
        {"type": "text", "text": "LAUNCH MAP  ·  {utc}", "x": "pillX + seg0 + (pillW - seg0)/2", "y": "pillY + pillH/2 + fs*0.36", "size": "fs", "color": "#FFF3E6", "tracking": 0.16, "maxw": "(pillW - seg0)*0.92", "opacity": "cdA", "font": "monoMedium"},
        {"type": "button", "x": "pillX", "y": "pillY", "w": "seg0", "h": "pillH", "radius": "pillH/2", "set": "view", "to": 0, "color": "#FFFFFF/0.07"},
        {"type": "button", "x": "pillX + seg0", "y": "pillY", "w": "pillW - seg0", "h": "pillH", "radius": "pillH/2", "set": "view", "to": 1, "color": "#FFFFFF/0.07"},
        {"type": "button", "x": 0, "y": 0, "w": 0, "h": 0, "set": "view", "to": "1 - view", "key": "tab"},
        {"type": "button", "x": 0, "y": 0, "w": 0, "h": 0, "set": "view", "to": "1 - view", "key": "space"},
        // ==== VIEW 1: THE COUNTDOWN ====
        // Everything in this view has  "when": "cdOn"  (only while this view is showing) and fades with  cdA  (the fade between the two views).
        // the police stars (six, as in GTA VI): the number lit is "starsShown": six minus the days to go (2 days = 4 stars), all six on the last day.
        // The NEXT star glows a little more every hour of the day, then lights fully at midnight.
        // Once the game is out all six blink on and off together, red and blue like the lights of a police car, fast on launch day and calmer after.
        {"type": "shapes", "when": "cdOn && releaseDay == 0", "shape": "star", "count": 6, "x": 0.5, "y": "starsY", "size": 0.0235, "lit": "starsShown", "color": "#FF3E91", "opacity": "cdA"},
        {"type": "shapes", "when": "cdOn && releaseDay", "shape": "star", "count": 6, "x": 0.5, "y": "starsY", "size": 0.0235, "lit": "starsShown", "color": "#FF2B3D", "color2": "#2B7BFF", "flash": 2.4, "opacity": "cdA"},
        {"type": "shapes", "when": "cdOn && nextStar", "shape": "star", "count": 1, "x": "0.5 + (starLit - 2.5)*starGap", "y": "starsY", "size": 0.0235, "lit": 1, "color": "#FF3E91", "glow": 0.2, "opacity": "cdA*0.8*starFrac"},
